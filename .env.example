# Core runtime
# Demo mode works without credentials or network access.
MATERIA_PROVIDER=demo
MATERIA_DATA_DIR=.data

# Network access
# Optimized native and Docker runs bind to loopback by default.
MATERIA_BIND_ADDRESS=127.0.0.1
# Development-only allowlist. Add comma-separated trusted LAN/private-network hosts when using `pnpm run dev:remote`.
MATERIA_ALLOWED_DEV_ORIGINS=127.0.0.1

# OpenAI (optional)
# Enables direct text and speech generation when a server-side key is present.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_SPEECH_VOICE=coral
OPENAI_SPEECH_SPEED=1
# OPENAI_SPEECH_INSTRUCTIONS=Read the complete text literally with a clear, consistent teaching tone.

# Direct local speech endpoints (optional compatibility path)
# Leave these empty when using only the federated voice-node gateway below.
KOKORO_BASE_URL=
KOKORO_SPEECH_MODEL=mlx-community/Kokoro-82M-bf16
KOKORO_SPEECH_VOICE=ef_dora
KOKORO_LANGUAGE=e
KOKORO_SPEECH_SPEED=1
KOKORO_TIMEOUT_MS=120000

# Qwen reuses KOKORO_BASE_URL when QWEN_BASE_URL is empty.
QWEN_BASE_URL=
QWEN_SPEECH_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-6bit
QWEN_TIMEOUT_MS=180000

# Federated voice nodes (optional, recommended for local TTS)
# URLs and tokens remain in the server process. Duplicate the token variable and add it to Compose when separate nodes need separate credentials.
# MATERIA_VOICE_NODES=[{"id":"local-node","label":"Local voice node","baseUrl":"http://voice-node.internal:8880","tokenEnv":"MATERIA_VOICE_NODE_TOKEN"}]
MATERIA_VOICE_NODES=[]
MATERIA_VOICE_NODE_TOKEN=
VOICE_NODE_TIMEOUT_MS=900000
# Timeout for each short gateway request; it does not limit the complete inference.
VOICE_NODE_REQUEST_TIMEOUT_MS=30000
# Polling interval for asynchronous TTS jobs.
VOICE_NODE_POLL_INTERVAL_MS=1000

# Docker storage (optional)
# Select a different operator-managed volume name without copying data.
# MATERIA_DATA_VOLUME=materia-data
