{
  "name": "materia",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, source-grounded courses with optional generated audio.",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "dev:remote": "next dev --hostname 0.0.0.0 --port 3210",
    "build": "next build && node scripts/prepare-standalone.mjs && node scripts/verify-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run tests/smoke",
    "mcp": "node --import tsx --conditions=react-server src/mcp/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "next": "16.3.1",
    "openai": "7.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
